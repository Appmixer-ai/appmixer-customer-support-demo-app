# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key for server-side API endpoints (required for API operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Appmixer Configuration
VITE_APPMIXER_BASE_URL=https://api.your-tenant.appmixer.cloud
# Optional: Override the app's API base URL for service account injection
VITE_APP_API_BASE_URL=https://your-app-domain.com
VITE_APPMIXER_CHAT_FLOW_ID=your-chat-flow-id
VITE_APPMIXER_CHAT_COMPONENT_ID=your-chat-component-id

# Custom modifiers deploy (config-as-code: npm run modifiers:deploy)
# Admin-only PUT /modifiers — keep server-side, NEVER use a VITE_* var for the token.
# APPMIXER_API_URL defaults to VITE_APPMIXER_BASE_URL when omitted.
APPMIXER_API_URL=https://api.your-tenant.appmixer.cloud
APPMIXER_ADMIN_TOKEN=your_appmixer_admin_token

# Development Server Configuration
DEV_SERVER_PORT=3001
VITE_DEV_PORT=8080

# API Authentication (comma-separated list of demo API keys)
# Leave empty or remove to disable demo mode
DEMO_API_KEYS=

# External Services (optional)
VITE_BUILDER_IO_PROJECT_ID=your_builder_io_project_id

# ID Generation Patterns
TICKET_ID_PREFIX=TICK-
CUSTOMER_ID_PREFIX=CUST-
DEFAULT_USER_NAME_PREFIX=User-
