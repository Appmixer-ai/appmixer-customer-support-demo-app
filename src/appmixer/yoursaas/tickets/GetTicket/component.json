{
    "name": "appmixer.yoursaas.tickets.GetTicket",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Retrieves a specific ticket from YourSaaS by ID.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string",
                        "example": "ticket-001"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "group": "ticket",
                        "label": "Ticket ID",
                        "index": 1
                    }
                },
                "groups": {
                    "ticket": {
                        "label": "Ticket Details",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "ticket",
            "options": [
                {
                    "label": "id",
                    "value": "id"
                },
                {
                    "label": "title",
                    "value": "title"
                },
                {
                    "label": "description",
                    "value": "description"
                },
                {
                    "label": "priority",
                    "value": "priority"
                },
                {
                    "label": "status",
                    "value": "status"
                },
                {
                    "label": "customer.id",
                    "value": "customer.id"
                },
                {
                    "label": "customer.name",
                    "value": "customer.name"
                },
                {
                    "label": "customer.email",
                    "value": "customer.email"
                },
                {
                    "label": "assignee",
                    "value": "assignee"
                },
                {
                    "label": "createdAt",
                    "value": "createdAt"
                },
                {
                    "label": "updatedAt",
                    "value": "updatedAt"
                },
                {
                    "label": "tags",
                    "value": "tags"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
