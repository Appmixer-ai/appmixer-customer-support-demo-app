{
    "name": "appmixer.yoursaas.tickets.GetTicketTags",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Gets all tags for a specific ticket in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string",
                        "example": "ticket-001"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "group": "ticket",
                        "label": "Ticket ID",
                        "index": 1
                    }
                },
                "groups": {
                    "ticket": {
                        "label": "Ticket",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tags",
            "options": [
                {
                    "label": "ticketId",
                    "value": "ticketId"
                },
                {
                    "label": "tags",
                    "value": "tags"
                },
                {
                    "label": "count",
                    "value": "count"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
