{
    "name": "appmixer.yoursaas.tickets.ListTickets",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Retrieves all tickets from YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "new",
                            "in-progress",
                            "resolved",
                            "closed"
                        ],
                        "example": "new"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "low",
                            "medium",
                            "high",
                            "urgent"
                        ],
                        "example": "high"
                    },
                    "tags": {
                        "type": "string",
                        "description": "Filter by tags (comma-separated)",
                        "example": "bug,frontend,urgent"
                    }
                },
                "required": []
            },
            "inspector": {
                "inputs": {
                    "status": {
                        "type": "select",
                        "group": "filters",
                        "label": "Status Filter",
                        "index": 1,
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "New",
                                "value": "new"
                            },
                            {
                                "label": "In Progress",
                                "value": "in-progress"
                            },
                            {
                                "label": "Resolved",
                                "value": "resolved"
                            },
                            {
                                "label": "Closed",
                                "value": "closed"
                            }
                        ]
                    },
                    "priority": {
                        "type": "select",
                        "group": "filters",
                        "label": "Priority Filter",
                        "index": 2,
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "Low",
                                "value": "low"
                            },
                            {
                                "label": "Medium",
                                "value": "medium"
                            },
                            {
                                "label": "High",
                                "value": "high"
                            },
                            {
                                "label": "Urgent",
                                "value": "urgent"
                            }
                        ]
                    },
                    "tags": {
                        "type": "text",
                        "group": "filters",
                        "label": "Tag Filter",
                        "index": 3,
                        "placeholder": "e.g., bug,urgent,frontend"
                    }
                },
                "groups": {
                    "filters": {
                        "label": "Filters",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tickets",
            "options": [
                {
                    "label": "tickets",
                    "value": "tickets"
                },
                {
                    "label": "count",
                    "value": "count"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
