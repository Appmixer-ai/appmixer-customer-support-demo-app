{
    "name": "appmixer.yoursaas.tickets.TicketPriorityChanged",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Triggers when a ticket priority changes in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
