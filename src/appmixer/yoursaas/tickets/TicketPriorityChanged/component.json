    "outPorts": [
        {
            "name": "ticket",
            "options": [
                {
                    "label": "id",
                    "value": "id"
                },
                {
                    "label": "title",
                    "value": "title"
                },
                {
                    "label": "description",
                    "value": "description"
                },
                {
                    "label": "status",
                    "value": "status"
                },
                {
                    "label": "previousPriority",
