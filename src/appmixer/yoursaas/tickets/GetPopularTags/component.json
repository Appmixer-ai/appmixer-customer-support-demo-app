{
    "name": "appmixer.yoursaas.tickets.GetPopularTags",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Gets the most popular tags based on ticket usage in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limit": {
                        "type": "number",
                        "description": "Maximum number of popular tags to return",
                        "example": 10
                    }
                },
                "required": []
            },
            "inspector": {
                "inputs": {
                    "limit": {
                        "type": "number",
                        "group": "options",
                        "label": "Limit",
                        "index": 1,
                        "defaultValue": 10,
                        "tooltip": "Maximum number of popular tags to return"
                    }
                },
                "groups": {
                    "options": {
                        "label": "Options",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tags",
            "options": [
                {
                    "label": "popularTags",
                    "value": "popularTags"
                },
                {
                    "label": "total",
                    "value": "total"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
