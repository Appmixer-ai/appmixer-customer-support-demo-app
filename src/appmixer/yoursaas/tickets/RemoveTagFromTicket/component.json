{
    "name": "appmixer.yoursaas.tickets.RemoveTagFromTicket",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Removes a specific tag from a ticket in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string",
                        "example": "ticket-001"
                    },
                    "tagId": {
                        "type": "string",
                        "description": "Tag name/ID to remove",
                        "example": "bug"
                    }
                },
                "required": [
                    "ticketId",
                    "tagId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "group": "ticket",
                        "label": "Ticket ID",
                        "index": 1
                    },
                    "tagId": {
                        "type": "text",
                        "group": "ticket",
                        "label": "Tag Name",
                        "index": 2
                    }
                },
                "groups": {
                    "ticket": {
                        "label": "Ticket & Tag",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "result",
            "options": [
                {
                    "label": "ticketId",
                    "value": "ticketId"
                },
                {
                    "label": "removedTag",
                    "value": "removedTag"
                },
                {
                    "label": "remainingTags",
                    "value": "remainingTags"
                },
                {
                    "label": "success",
                    "value": "success"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
