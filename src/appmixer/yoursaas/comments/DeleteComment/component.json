{
    "name": "appmixer.yoursaas.comments.DeleteComment",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Deletes a comment from a ticket in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string",
                        "example": "ticket-001"
                    },
                    "commentId": {
                        "type": "string",
                        "example": "comment-001"
                    }
                },
                "required": [
                    "ticketId",
                    "commentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "group": "comment",
                        "label": "Ticket ID",
                        "index": 1
                    },
                    "commentId": {
                        "type": "text",
                        "group": "comment",
                        "label": "Comment ID",
                        "index": 2
                    }
                },
                "groups": {
                    "comment": {
                        "label": "Comment Details",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "result",
            "options": [
                {
                    "label": "deleted",
                    "value": "deleted"
                },
                {
                    "label": "commentId",
                    "value": "commentId"
                },
                {
                    "label": "ticketId",
                    "value": "ticketId"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
