{
    "name": "appmixer.yoursaas.comments.ListComments",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Retrieves all comments for a specific ticket from YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string",
                        "example": "ticket-001"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "group": "ticket",
                        "label": "Ticket ID",
                        "index": 1
                    }
                },
                "groups": {
                    "ticket": {
                        "label": "Ticket Details",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "comments",
            "options": [
                {
                    "label": "comments",
                    "value": "comments"
                },
                {
                    "label": "count",
                    "value": "count"
                },
                {
                    "label": "ticketId",
                    "value": "ticketId"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
