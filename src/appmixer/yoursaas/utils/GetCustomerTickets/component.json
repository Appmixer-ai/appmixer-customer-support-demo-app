{
    "name": "appmixer.yoursaas.utils.GetCustomerTickets",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Retrieves all tickets for a specific customer from YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string",
                        "example": "customer-001"
                    }
                },
                "required": [
                    "customerId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "group": "customer",
                        "label": "Customer ID",
                        "index": 1
                    }
                },
                "groups": {
                    "customer": {
                        "label": "Customer Details",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tickets",
            "options": [
                {
                    "label": "tickets",
                    "value": "tickets"
                },
                {
                    "label": "count",
                    "value": "count"
                },
                {
                    "label": "customerId",
                    "value": "customerId"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
