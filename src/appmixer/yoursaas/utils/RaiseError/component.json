{
    "name": "appmixer.yoursaas.utils.RaiseError",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Throws an error to simulate a faulty flow for testing error handling.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "errorMessage": {
                        "type": "string",
                        "example": "Something went wrong"
                    }
                },
                "required": []
            },
            "inspector": {
                "inputs": {
                    "errorMessage": {
                        "type": "text",
                        "label": "Error Message",
                        "index": 1,
                        "tooltip": "Custom error message to throw (optional)",
                        "defaultValue": "Simulated error for testing"
                    }
                },
                "groups": {
                    "errorMessage": "Error Configuration"
                }
            }
        }
    ],
    "outPorts": [],
    "icon": "data:image/svg+xml;base64,"
}
