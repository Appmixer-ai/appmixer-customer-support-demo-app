{
    "name": "appmixer.yoursaas.tags.DeleteTag",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Deletes a tag from YourSaaS and removes it from all tickets.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "tagId": {
                        "type": "string",
                        "example": "bug"
                    }
                },
                "required": [
                    "tagId"
                ]
            },
            "inspector": {
                "inputs": {
                    "tagId": {
                        "type": "text",
                        "group": "tag",
                        "label": "Tag ID/Name",
                        "index": 1
                    }
                },
                "groups": {
                    "tag": {
                        "label": "Tag Details",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "result",
            "options": [
                {
                    "label": "tagId",
                    "value": "tagId"
                },
                {
                    "label": "deleted",
                    "value": "deleted"
                },
                {
                    "label": "deletedAt",
                    "value": "deletedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
