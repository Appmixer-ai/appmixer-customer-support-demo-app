{
    "name": "appmixer.yoursaas.tags.NewTag",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Triggers when a new tag is created in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "tick": true,
    "outPorts": [
        {
            "name": "tag",
            "options": [
                {
                    "label": "id",
                    "value": "id"
                },
                {
                    "label": "name",
                    "value": "name"
                },
                {
                    "label": "color",
                    "value": "color"
                },
                {
                    "label": "description",
                    "value": "description"
                },
                {
                    "label": "usageCount",
                    "value": "usageCount"
                },
                {
                    "label": "createdAt",
                    "value": "createdAt"
                },
                {
                    "label": "updatedAt",
                    "value": "updatedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
