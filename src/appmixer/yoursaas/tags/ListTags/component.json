{
    "name": "appmixer.yoursaas.tags.ListTags",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Retrieves all tags from YourSaaS with usage statistics.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "popular": {
                        "type": "boolean",
                        "description": "Get only popular tags",
                        "example": true
                    },
                    "limit": {
                        "type": "number",
                        "description": "Limit number of tags returned",
                        "example": 10
                    }
                },
                "required": []
            },
            "inspector": {
                "inputs": {
                    "popular": {
                        "type": "toggle",
                        "group": "options",
                        "label": "Popular Tags Only",
                        "index": 1,
                        "defaultValue": false
                    },
                    "limit": {
                        "type": "number",
                        "group": "options",
                        "label": "Limit",
                        "index": 2,
                        "defaultValue": 10,
                        "tooltip": "Maximum number of tags to return"
                    }
                },
                "groups": {
                    "options": {
                        "label": "Options",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tags",
            "options": [
                {
                    "label": "tags",
                    "value": "tags"
                },
                {
                    "label": "count",
                    "value": "count"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
