{
    "name": "appmixer.yoursaas.customers.NewCustomer",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Triggers when a new customer is created in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "tick": true,
    "outPorts": [
        {
            "name": "customer",
            "options": [
                {
                    "label": "id",
                    "value": "id"
                },
                {
                    "label": "name",
                    "value": "name"
                },
                {
                    "label": "email",
                    "value": "email"
                },
                {
                    "label": "avatar",
                    "value": "avatar"
                },
                {
                    "label": "createdAt",
                    "value": "createdAt"
                },
                {
                    "label": "updatedAt",
                    "value": "updatedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
