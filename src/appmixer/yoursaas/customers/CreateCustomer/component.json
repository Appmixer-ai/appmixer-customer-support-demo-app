{
    "name": "appmixer.yoursaas.customers.CreateCustomer",
    "author": "Petr Olivka <petr@appmixer.com>",
    "description": "Creates a new customer in YourSaaS.",
    "private": false,
    "auth": {
        "service": "appmixer:yoursaas"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john.doe@example.com"
                    },
                    "avatar": {
                        "type": "string",
                        "example": "https://example.com/avatars/john.png"
                    }
                },
                "required": [
                    "name",
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "group": "customer",
                        "label": "Name",
                        "index": 1
                    },
                    "email": {
                        "type": "email",
                        "group": "customer",
                        "label": "Email",
                        "index": 2
                    },
                    "avatar": {
                        "type": "text",
                        "group": "customer",
                        "label": "Avatar URL",
                        "index": 3
                    }
                },
                "groups": {
                    "customer": {
                        "label": "Customer Details",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "customer",
            "options": [
                {
                    "label": "id",
                    "value": "id"
                },
                {
                    "label": "name",
                    "value": "name"
                },
                {
                    "label": "email",
                    "value": "email"
                },
                {
                    "label": "avatar",
                    "value": "avatar"
                },
                {
                    "label": "createdAt",
                    "value": "createdAt"
                },
                {
                    "label": "updatedAt",
                    "value": "updatedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
